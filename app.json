{
  "expo": {
    "name": "Apex Coach",
    "slug": "apex-coach",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "apexcoach",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0E1A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.apexcoach.mobile",
      "associatedDomains": [
        "applinks:apexcoach.app"
      ],
      "infoPlist": {
        "NSCameraUsageDescription": "Pour tes photos de progression",
        "NSPhotoLibraryUsageDescription": "Pour sauvegarder tes photos de progression"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#0A0E1A"
      },
      "package": "app.apexcoach.mobile",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "apexcoach.app",
              "pathPrefix": "/mobile"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0E1A"
        }
      ],
      "expo-web-browser",
      "@sentry/react-native"
    ]
  }
}
